# Production .env for the VPS. Copy to /opt/openwa/.env on the server (chmod 600) and fill in
# every <...> value. Never commit the real file.
#   Generate secrets with:  openssl rand -hex 32

# --- Domain / URLs ---
OPENWA_DOMAIN=openwa.abrahamkonany.com
BASE_URL=https://openwa.abrahamkonany.com
DASHBOARD_URL=https://openwa.abrahamkonany.com
CORS_ORIGINS=https://openwa.abrahamkonany.com

# --- Core ---
NODE_ENV=production
API_PORT=2785
LOG_LEVEL=info
TZ=UTC

# --- WhatsApp engine ---
# Baileys: no Chromium. whatsapp-web.js 1.34.8 does not work with the current WhatsApp Web build.
ENGINE_TYPE=baileys

# --- Database (built-in Postgres container, `--profile postgres`) ---
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=openwa
DATABASE_USERNAME=openwa
DATABASE_PASSWORD=<openssl rand -hex 32>
POSTGRES_SCHEMA=public
DATABASE_SYNCHRONIZE=false

# --- Security ---
# Set BEFORE the first boot and never change it afterwards (changing it locks out every API key).
API_KEY_PEPPER=<openssl rand -hex 32>
# Caddy reaches the API over a Docker bridge network (allocated from 172.16.0.0/12). The API port is
# bound to 127.0.0.1 only, so only containers on this host can send X-Forwarded-* headers.
TRUSTED_PROXIES=172.16.0.0/12
DASHBOARD_SESSION_COOKIE_SECURE=true

# --- Resources ---
OPENWA_MEM_LIMIT=2g
OPENWA_PIDS_LIMIT=2048
